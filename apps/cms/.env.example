# Server
HOST=0.0.0.0
PORT=1337

# Secrets — genera valores nuevos con: node -e "require('crypto').randomBytes(16).toString('base64')"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Database (Railway provee estos valores automáticamente con PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true

# CORS — URL de tu frontend en Vercel
CORS_ORIGIN=https://tu-app.vercel.app
